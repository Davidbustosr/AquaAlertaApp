<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".EstanqueActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💧 Modo Estanque"
                android:textColor="@color/agua_oscuro"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipo IoT simulado (AquaAlerta v2 · Unidad 1)"
                android:textColor="@color/texto_suave" />

            <!-- 1. Configuracion de red y seguridad -->
            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:text="1. Conexión Wi-Fi" />

                    <TextView
                        android:id="@+id/tvIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/texto"
                        android:textIsSelectable="true" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Campo"
                        android:hint="Código de enlace (cifrado, mín. 6)"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLength="32"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Campo"
                        android:hint="PIN del equipo para comandos (4 a 6 dígitos)"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtClave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberPassword"
                            android:maxLength="6"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnIniciar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Iniciar equipo" />

                    <TextView
                        android:id="@+id/tvConexion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Equipo detenido"
                        android:textColor="@color/agua_oscuro"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Sensor simulado -->
            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:text="2. Sensor de nivel (mueva para simular el agua)" />

                    <SeekBar
                        android:id="@+id/seekNivel"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:max="1023"
                        android:progress="100" />

                    <TextView
                        android:id="@+id/tvAdc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lectura del sensor (ADC): - / 1023"
                        android:textColor="@color/texto" />

                    <ProgressBar
                        android:id="@+id/barNivel"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="6dp"
                        android:max="1023"
                        android:progressTint="@color/agua_claro" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Umbrales: ALTO ≥ 350 · REBALSE ≥ 700 · histéresis 30 · confirma 3 lecturas"
                        android:textColor="@color/texto_suave"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Estado y actuadores -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstado"
                style="@style/Tarjeta"
                app:cardBackgroundColor="@color/estado_paro">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DETENIDO"
                        android:textColor="@color/blanco"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvValvula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Válvula de llenado: -"
                        android:textColor="@color/blanco"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvAlarma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/blanco"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnFisico"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/texto"
                android:text="BOTÓN FÍSICO\ntoque: silenciar · mantener: PARO / reanudar"
                android:textSize="13sp" />

            <!-- 4. Bitacora -->
            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:text="Bitácora del equipo" />

                    <TextView
                        android:id="@+id/tvBitacora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_bitacora"
                        android:fontFamily="monospace"
                        android:minHeight="80dp"
                        android:padding="8dp"
                        android:textColor="@color/texto"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
