<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".MonitorActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📡 Modo Monitor"
                android:textColor="@color/agua_oscuro"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_suave" />

            <!-- 1. Conexion -->
            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:text="1. Conectar con el equipo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Campo"
                            android:layout_width="0dp"
                            android:layout_weight="3"
                            android:hint="IP del equipo">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtIp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="0123456789."
                                android:inputType="number"
                                android:maxLength="15"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Campo"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="2"
                            android:hint="Puerto">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtPuerto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="5"
                                android:maxLines="1"
                                android:text="5050" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Campo"
                        android:hint="Código de enlace (el mismo del equipo)"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLength="32"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnConectar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Conectar" />

                    <TextView
                        android:id="@+id/tvConexion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sin conexión"
                        android:textColor="@color/agua_oscuro"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Estado en tiempo real -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstado"
                style="@style/Tarjeta"
                app:cardBackgroundColor="@color/estado_paro">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIN DATOS"
                        android:textColor="@color/blanco"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/barNivel"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="8dp"
                        android:max="1023"
                        android:progressBackgroundTint="@color/blanco"
                        android:progressTint="@color/agua_claro" />

                    <TextView
                        android:id="@+id/tvDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textColor="@color/blanco"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvAlarma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/blanco"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvActualizado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/blanco"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Comandos -->
            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:text="3. Comandos remotos" />

                    <TextView
                        android:id="@+id/tvPermisos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/texto_suave"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnConsultar"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:text="Consultar estado (?)" />

                    <Button
                        android:id="@+id/btnSilenciar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="4dp"
                        android:backgroundTint="@color/estado_alto"
                        android:text="Silenciar alarma (PIN)" />

                    <Button
                        android:id="@+id/btnParo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="4dp"
                        android:backgroundTint="@color/estado_rebalse"
                        android:text="PARO DE EMERGENCIA (PIN)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Bitacora -->
            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:text="Bitácora del monitor" />

                    <TextView
                        android:id="@+id/tvBitacora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_bitacora"
                        android:fontFamily="monospace"
                        android:minHeight="80dp"
                        android:padding="8dp"
                        android:textColor="@color/texto"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
