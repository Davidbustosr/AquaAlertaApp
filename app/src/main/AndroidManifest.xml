<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos minimos (ISO 27400: minimo privilegio). Solo red local, sin ubicacion ni almacenamiento. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 17+: permiso que el usuario concede para hablar con otros equipos de la red local -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- allowBackup=false: la base de usuarios y el historial no salen del equipo por respaldos en la nube. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AquaAlerta">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".RegistroActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MenuActivity" android:exported="false" />
        <!-- configChanges: al girar el telefono no se recrea la pantalla, asi la conexion no se corta -->
        <activity android:name=".EstanqueActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MonitorActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HistorialActivity" android:exported="false" />
    </application>

</manifest>
